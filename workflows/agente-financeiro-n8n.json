{
  "name": "Agente Financeiro Inteligente - Treinamento Prático N8N",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "bot-financeiro",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {
          "ipWhitelist": ""
        }
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Webhook Bot Financeiro",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "bot-financeiro-dio-training"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "norm-1",
              "name": "usuarioNome",
              "value": "={{ ($json.body?.usuario || 'Arthur').trim() }}",
              "type": "string"
            },
            {
              "id": "norm-2",
              "name": "telefoneLimpo",
              "value": "={{ ($json.body?.telefone || '').toString().replace(/\\D/g, '') }}",
              "type": "string"
            },
            {
              "id": "norm-3",
              "name": "opcaoMenu",
              "value": "={{ ($json.body?.opcao || '1').toString().trim() }}",
              "type": "string"
            },
            {
              "id": "norm-4",
              "name": "tipoTransacao",
              "value": "={{ ($json.body?.tipo || 'DESPESA').toString().toUpperCase() }}",
              "type": "string"
            },
            {
              "id": "norm-5",
              "name": "categoria",
              "value": "={{ $json.body?.categoria || 'Geral' }}",
              "type": "string"
            },
            {
              "id": "norm-6",
              "name": "descricao",
              "value": "={{ $json.body?.descricao || 'Lançamento via Bot' }}",
              "type": "string"
            },
            {
              "id": "norm-7",
              "name": "valorNumerico",
              "value": "={{ ($json.body?.valor || '0').toString().replace(/[^0-9,.-]/g, '').replace(',', '.').toNumber() }}",
              "type": "number"
            },
            {
              "id": "norm-8",
              "name": "formaPagamento",
              "value": "={{ $json.body?.formaPagamento || 'PIX' }}",
              "type": "string"
            },
            {
              "id": "norm-9",
              "name": "dataVencimento",
              "value": "={{ ($json.body?.dataVencimento ? $json.body.dataVencimento.toDateTime() : $now).toFormat('yyyy-MM-dd') }}",
              "type": "string"
            },
            {
              "id": "norm-10",
              "name": "mesReferencia",
              "value": "={{ ($json.body?.dataVencimento ? $json.body.dataVencimento.toDateTime() : $now).toFormat('MM') }}",
              "type": "string"
            },
            {
              "id": "norm-11",
              "name": "idTransacao",
              "value": "={{ 'FIN-' + Math.floor(Math.random() * 1000000).toString() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Normalizar e Converter Dados",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.opcaoMenu }}",
                    "rightValue": "1",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "1_Registrar"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.opcaoMenu }}",
                    "rightValue": "2",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "2_Resumo"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Roteador Menu do Chatbot",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-val-1",
              "leftValue": "={{ $json.valorNumerico }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Filtrar Valor Válido (> 0)",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [
        980,
        180
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "SEU_GOOGLE_SHEET_ID_AQUI",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Lancamentos",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "ID": "={{ $json.idTransacao }}",
            "Data_Vencimento": "={{ $json.dataVencimento }}",
            "Mes": "={{ $json.mesReferencia }}",
            "Usuario": "={{ $json.usuarioNome }}",
            "Telefone": "={{ $json.telefoneLimpo }}",
            "Tipo": "={{ $json.tipoTransacao }}",
            "Categoria": "={{ $json.categoria }}",
            "Descricao": "={{ $json.descricao }}",
            "Valor": "={{ $json.valorNumerico }}",
            "Forma_Pagamento": "={{ $json.formaPagamento }}"
          }
        },
        "options": {}
      },
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "Salvar Lançamento (Google Sheets)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1220,
        180
      ],
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"status\": \"sucesso\",\n  \"mensagem\": \"✅ Transação registrada com sucesso, {{ $('Normalizar e Converter Dados').item.json.usuarioNome }}!\",\n  \"detalhes\": {\n    \"id\": \"{{ $('Normalizar e Converter Dados').item.json.idTransacao }}\",\n    \"tipo\": \"{{ $('Normalizar e Converter Dados').item.json.tipoTransacao }}\",\n    \"categoria\": \"{{ $('Normalizar e Converter Dados').item.json.categoria }}\",\n    \"valorFormatado\": \"R$ {{ $('Normalizar e Converter Dados').item.json.valorNumerico.toFixed(2) }}\",\n    \"vencimento\": \"{{ $('Normalizar e Converter Dados').item.json.dataVencimento }}\",\n    \"mesReferencia\": \"{{ $('Normalizar e Converter Dados').item.json.mesReferencia }}\"\n  }\n}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "a1b2c3d4-0006-4000-8000-000000000006",
      "name": "Responder Sucesso ao Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1460,
        180
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"status\": \"menu\",\n  \"mensagem\": \"🤖 Olá, {{ $json.usuarioNome }}! Escolha uma opção do Agente Financeiro:\\n1: Financeiro - Registrar Receita/Despesa\\n2: Suporte - Consultar Resumo do Mês ({{ $json.mesReferencia }})\\n3: Falar com um consultor / Ajuda\"\n}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "a1b2c3d4-0007-4000-8000-000000000007",
      "name": "Responder Menu Interativo",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        980,
        420
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      },
      "id": "a1b2c3d4-0008-4000-8000-000000000008",
      "name": "Agendamento Diário (08:00)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        740
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://sandbox.asaas.com/api/v3/payments",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "status",
              "value": "PENDING"
            },
            {
              "name": "dueDate[le]",
              "value": "={{ $now.plus({ days: 3 }).toFormat('yyyy-MM-dd') }}"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0009-4000-8000-000000000009",
