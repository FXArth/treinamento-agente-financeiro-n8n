    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "html-1",
              "name": "assuntoEmail",
              "value": "={{ '🔔 Lembrete Financeiro: ' + $json.name + ' - Vencimento em ' + $json.dueDate.toDateTime().toFormat('dd/MM/yyyy') }}",
              "type": "string"
            },
            {
              "id": "html-2",
              "name": "corpoHtml",
              "value": "={{ 'Olá, <strong>' + $json.name + '</strong>!<br><br>Identificamos um lançamento financeiro próximo do vencimento:<br>• <strong>Descrição:</strong> ' + ($json.description || 'Fatura') + '<br>• <strong>Valor:</strong> R$ ' + $json.value.toString() + '<br>• <strong>Vencimento:</strong> ' + $json.dueDate.toDateTime().toFormat('dd/MM/yyyy') + '<br>• <strong>Forma de Pagamento:</strong> ' + $json.billingType + '<br><br>Atenciosamente,<br><strong>Agente Financeiro N8N</strong>' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0016-4000-8000-000000000016",
      "name": "Montar Template HTML (Edit Fields)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1620,
        660
      ]
    },
    {
      "parameters": {
        "fromEmail": "financeiro@suaempresa.com.br",
        "toEmail": "={{ $json.email }}",
        "subject": "={{ $json.assuntoEmail }}",
        "html": "={{ $json.corpoHtml }}",
        "options": {}
      },
      "id": "a1b2c3d4-0017-4000-8000-000000000017",
      "name": "Send Email (Alerta de Vencimento)",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1860,
        660
      ],
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "amount": 3,
        "unit": "seconds"
      },
      "id": "a1b2c3d4-0018-4000-8000-000000000018",
      "name": "Wait (Espaçar Envios)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        2080,
        660
      ]
    },
    {
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "lancamentosAgregados",
        "options": {}
      },
      "id": "a1b2c3d4-0019-4000-8000-000000000019",
      "name": "Aggregate (Juntar Itens para Relatório)",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        1620,
        880
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "rep-1",
              "name": "relatorioConsolidadoHtml",
              "value": "={{ '<h2>📊 Relatório Diário de Contas a Vencer</h2><br>' + $json.lancamentosAgregados.map(item => '• <strong>' + item.name + '</strong>: R$ ' + item.value + ' (' + item.billingType + ') - Vence em: ' + item.dueDate).join('<br>') }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0020-4000-8000-000000000020",
      "name": "Formatar Relatório com .join('<br>')",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1860,
        880
      ]
    }
